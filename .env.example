# PostgreSQL (Neon, Supabase, Vercel Postgres, Railway...)
DATABASE_URL="postgresql://user:password@localhost:5432/tra_layout"
# Long random string: openssl rand -base64 32
JWT_SECRET="change-me"
# Used by `npm run seed` to create the admin account
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-now"
# Optional: Vercel Blob for uploads (otherwise saved to public/uploads — local dev only)
BLOB_READ_WRITE_TOKEN=""
# Optional: extra allowed image hosts (comma separated), e.g. res.cloudinary.com
IMAGE_HOSTS=""
